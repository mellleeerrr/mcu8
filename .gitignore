# Сборка
/target/

# Секреты локальной разработки (BACKEND_RULES §6.3: только env, не в репозиторий)
.env
.env.*

# Фронтенд PNM (client/pnm-frontend/):
# предсжатые .gz генерируются scripts/import-pnm-frontend.sh --gzip (регенерируемы)
client/pnm-frontend/deployed/**/*.gz
# исходники старого фронтенда распаковываются по требованию (--with-source)
client/pnm-frontend/source/
# .bak-файлы архива в рантайм не импортируются
*.bak*

# Архив исходников PNM (31 MB) хранится вне git; восстановление — scripts/import-pnm-frontend.sh
client/pnm-frontend/archive/
*.log
# логи приёмки/смоука — часть evidence и коммитятся
!docs/progress/evidence/**/*.log

# SQLite local runtime database
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite

# Локальные pid-файлы скриптов
*.pid

# Local acceptance artifacts (tokens, SQLite, sidecar probes, logs)
.accept/
.accept_*
.h323_*
.h323-venv/
deploy/vks.env
__pycache__/

# Живые E2E-артефакты (скриншоты/trace/network) — генерируются заново.
# По умолчанию пишутся ВНЕ репозитория ($XDG_STATE_HOME/vks/artifacts);
# каталог ниже — только если VKS_ARTIFACTS/VKS_ARTIFACTS_ROOT указывают внутрь.
/artifacts/
node_modules/
tests/e2e/node_modules/
test-results/
playwright-report/
blob-report/

# Локальная SQLite/бэкапы (не удалять, не коммитить)
vks_data.db.*

# Рабочие заметки и сгенерированные данные агентов (не коммитятся)
.work-tmp/
