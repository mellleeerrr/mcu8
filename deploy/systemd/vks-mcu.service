# DEV ONLY: user-level unit для локального стенда. Не устанавливайте
# system-wide: запускает release-бинарь от текущего пользователя и пишет
# dev-лог в репозиторий. Production — vks-mcu-prod.service.
[Unit]
Description=VKS MCU local stand (PROSTOR UI, SIP/H.323, SQLite)
Documentation=file:///home/pro/mcu/docs/progress/MASTER_TASK_LIST.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pro/mcu
Environment=VKS_H323_UAS_ENABLED=1
Environment=VKS_H323_UAS_ALLOW=127.0.0.1/32,192.168.1.0/24
Environment=VKS_H323_UAS_MAX_CALLS=20
Environment=VKS_H323_UAS_MAX_PER_IP=20
# Real str0m ICE-lite/DTLS-SRTP browser transport (1 on this stand).
Environment=VKS_WEBRTC_TRANSPORT=1
# DEV ONLY: IP этого стенда. В prod-юните значение задаётся через EnvironmentFile.
Environment=VKS_CANDIDATE_ADDR=192.168.1.93
# Firewall/NAT must open this UDP range; empty = ephemeral ports.
Environment=VKS_WEBRTC_PORT_MIN=43000
Environment=VKS_WEBRTC_PORT_MAX=43100
ExecStart=/home/pro/mcu/target/release/vks-server --config /home/pro/mcu/configs/default.toml
Restart=on-failure
RestartSec=2
# exit 78 (EX_CONFIG) — ошибка конфигурации: перезапуск не поможет, не зацикливаемся.
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65536
StandardOutput=append:/home/pro/mcu/vks_server.log
StandardError=append:/home/pro/mcu/vks_server.log

[Install]
WantedBy=default.target
