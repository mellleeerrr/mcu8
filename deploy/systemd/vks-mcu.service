# DEV ONLY: user-level unit для локального стенда. Не устанавливайте
# system-wide: запускает release-бинарь от текущего пользователя и пишет
# dev-лог в репозиторий. Production — vks-mcu-prod.service.
#
# Candidate IP и allowlist стенда задаются вне юнита, чтобы не хардкодить
# адрес машины в репозитории:
#   systemctl --user set-environment VKS_CANDIDATE_ADDR=<IP стенда>
# или drop-in ~/.config/systemd/user/vks-mcu.service.d/dev.conf с Environment=.
[Unit]
Description=VKS MCU local stand (PROSTOR UI, SIP/H.323, SQLite)
Documentation=file://%h/mcu/docs/progress/MASTER_TASK_LIST.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mcu
# T8: allowlist/лимиты H.323 — только один источник: deploy/vks.env.example
# (EnvironmentFile=, drop-in или `systemctl --user set-environment`). Здесь их
# нет, иначе unit молча перекрывает env и «единый источник» нарушается.
# Включается H.323 тоже снаружи: VKS_H323_UAS_ENABLED=1 в том же env/drop-in.
# Real str0m ICE-lite/DTLS-SRTP browser transport (1 on this stand).
# Mandatory (no off switch): unset/0 exits 78.
Environment=VKS_WEBRTC_TRANSPORT=1
# DEV ONLY: входящий SIP на стенде (в шаблоне по умолчанию выключен).
Environment=VKS_SIP_UAS_ENABLED=1
# Firewall/NAT must open this UDP range; empty = ephemeral ports.
Environment=VKS_WEBRTC_PORT_MIN=43000
Environment=VKS_WEBRTC_PORT_MAX=43100
# Memory allocator hygiene: background purging of dirty pages
Environment=MALLOC_CONF=background_thread:true,dirty_decay_ms:1000,muzzy_decay_ms:1000
ExecStart=%h/mcu/target/release/vks-server --config %h/mcu/configs/default.toml
Restart=on-failure
RestartSec=2
# exit 78 (EX_CONFIG) — ошибка конфигурации: перезапуск не поможет, не зацикливаемся.
RestartPreventExitStatus=78
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
TimeoutStopSec=10
LimitNOFILE=65536
StandardOutput=append:%h/mcu/vks_server.log
StandardError=append:%h/mcu/vks_server.log

[Install]
WantedBy=default.target
