[Unit]
Description=VKS MCU production (PROSTOR PNM, SIP/H.323, PostgreSQL)
After=network-online.target
Wants=network-online.target
# Restart policy limits belong to [Unit]; systemd ignores them in [Service].
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/vks
# Секреты обязательны: без файла unit падает до запуска сервера.
EnvironmentFile=/etc/vks/vks.env
# Конфиг читается из credential-копии: исходник 0600 root:root, DynamicUser
# не нуждается в доступе к /etc/vks.
LoadCredential=server.toml:/etc/vks/server.toml
Environment=PYTHONDONTWRITEBYTECODE=1
# Real WebRTC is ON by default; set the public candidate and an open UDP range.
# Use VKS_WEBRTC_TRANSPORT=0 only for a deliberate rollback to legacy SDP.
#Environment=VKS_CANDIDATE_ADDR=203.0.113.10
#Environment=VKS_WEBRTC_PORT_MIN=43000
#Environment=VKS_WEBRTC_PORT_MAX=43100
ExecStart=/opt/vks/bin/vks-server --config %d/server.toml
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65536
UMask=0077

# T15/L0 (cgroup v2): one slice for all vks services, hard memory ceiling and
# scheduling weights. The same values are provided as a drop-in for existing
# installs (deploy/host/systemd/vks-mcu-prod.service.d/10-l0-resources.conf);
# keep both in sync. RT scheduling is intentionally not enabled — media runs on
# the shared tokio runtime (docs/operations/host-l0-tuning.md §4).
Slice=vks.slice
MemoryHigh=2G
MemoryMax=3G
CPUWeight=200
IOWeight=100
Nice=-5
CPUSchedulingPolicy=other

# Hardening: запись только в State/LogsDirectory; /opt/vks и /etc/vks — read-only.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
ReadWritePaths=/var/lib/vks /var/log/vks
StateDirectory=vks
LogsDirectory=vks

[Install]
WantedBy=multi-user.target
