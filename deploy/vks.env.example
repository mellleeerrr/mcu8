# Production secrets for vks-server; chmod 0600 root:root.
# systemd reads this as root and passes the variables to the service process
# environment (visible in /proc/<pid>/environ and inherited by child processes).
# Never commit the real file.
#
# VKS_* environment variables override /etc/vks/server.toml. This example sets
# only secrets and paths that are not in the TOML; database_url/candidate_addr/
# frontend_dir stay in server.toml (edit it during first start).
VKS_JWT_SECRET=
# Required only for the first start or for one-time rotation of a weak DB
# password. After rotation it can be removed.
VKS_ADMIN_PASSWORD=
VKS_H323_PYTHON=/opt/vks/h323-venv/bin/python3
VKS_H323_HELPER=/opt/vks/share/vks-mcu/h323_sidecar.py
RUST_LOG=info
