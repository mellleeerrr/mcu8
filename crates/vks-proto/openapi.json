{
  "openapi": "3.0.3",
  "info": {
    "title": "VKS Admin API",
    "version": "1.0.0",
    "description": "Admin REST API VKS. Скеелет фазы 0; полное наполнение — фаза 5. Источник для progenitor (ADR-0013)."
  },
  "servers": [
    { "url": "/api/v1" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RoomDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "mode": { "type": "string", "enum": ["sfu", "mcu"] },
          "active": { "type": "boolean" },
          "participant_count": { "type": "integer" }
        }
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "display_name": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string", "enum": ["operator", "moderator", "participant", "viewer"] },
          "enabled": { "type": "boolean" }
        }
      },
      "LayoutDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["grid", "focus", "speaker", "custom"] },
          "is_default": { "type": "boolean" }
        }
      },
      "SettingsDto": {
        "type": "object",
        "properties": {
          "server_name": { "type": "string" },
          "listen_addr": { "type": "string" },
          "auth_provider": { "type": "string", "enum": ["local", "ldap", "oidc"] },
          "default_room_mode": { "type": "string", "enum": ["sfu", "mcu"] }
        }
      },
      "RecordDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "room_id": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "AuditEntry": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "timestamp_ms": { "type": "integer" },
          "actor_id": { "type": "string" },
          "action": { "type": "string" }
        }
      },
      "ModeSwitchRequest": {
        "type": "object",
        "properties": {
          "mode": { "type": "string", "enum": ["sfu", "mcu"] }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness",
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness (DB+NATS+media)",
        "responses": {
          "200": { "description": "ready" },
          "503": { "description": "not ready" }
        }
      }
    },
    "/rooms": {
      "get": {
        "summary": "List rooms",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "array of RoomDto" } }
      },
      "post": {
        "summary": "Create room",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoomDto" } } }
        },
        "responses": {
          "201": { "description": "created" },
          "401": { "description": "unauthorized" },
          "403": { "description": "forbidden" }
        }
      }
    },
    "/rooms/{id}": {
      "get": {
        "summary": "Get room",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "RoomDto" },
          "404": { "description": "not found" }
        }
      },
      "delete": {
        "summary": "Delete room",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "deleted" } }
      }
    },
    "/rooms/{id}/mode": {
      "patch": {
        "summary": "Per-room mode override (ADR-0026, Q7)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModeSwitchRequest" } } }
        },
        "responses": {
          "200": { "description": "switched" },
          "404": { "description": "not found" }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "List users",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "array of UserDto" } }
      }
    },
    "/layouts": {
      "get": {
        "summary": "List layouts",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "array of LayoutDto" } }
      },
      "post": {
        "summary": "Create layout",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LayoutDto" } } }
        },
        "responses": { "201": { "description": "created" } }
      }
    },
    "/settings": {
      "get": {
        "summary": "Get server settings (R6)",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "SettingsDto" } }
      },
      "patch": {
        "summary": "Update settings",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SettingsDto" } } }
        },
        "responses": { "200": { "description": "updated" } }
      }
    },
    "/records": {
      "get": {
        "summary": "List recordings",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "array of RecordDto" } }
      }
    },
    "/audit": {
      "get": {
        "summary": "Audit log (ADR-0019)",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "array of AuditEntry" } }
      }
    }
  }
}
